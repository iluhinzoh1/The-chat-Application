<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.chatclient.ChatController"
            prefHeight="400.0" prefWidth="600.0"
            stylesheets="@style.css">
    <!-- СЛЕВА: Список пользователей -->
    <left>
        <ListView fx:id="usersList" prefWidth="150.0"/>
    </left>

    <!-- В ЦЕНТРЕ: Большое поле с историей переписки -->
    <center>
        <TextArea fx:id="chatArea" editable="false" wrapText="true" focusTraversable="false"/>
    </center>

    <!-- СНИЗУ: Поле ввода и кнопка отправить -->
    <bottom>
        <HBox spacing="10.0" BorderPane.alignment="CENTER">
            <!-- Отступы от краев (padding) -->
            <padding>
                <Insets top="10.0" right="10.0" bottom="10.0" left="10.0"/>
            </padding>
            <!-- HBox.hgrow="ALWAYS" заставляет поле ввода растягиваться на всю свободную ширину -->
            <TextField fx:id="messageField" promptText="Введите сообщение..." HBox.hgrow="ALWAYS" onAction="#onSendMessage"/>
            <Button text="Отправить" onAction="#onSendMessage"/>
        </HBox>
    </bottom>

</BorderPane>
